# PostgreSQL connection string (auto-set by Railway — don't add manually there)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leetcode_tracker

# HTTP server port (auto-set by Railway — don't add manually there)
PORT=3000

# YOUR LeetCode username
MY_LEETCODE_USERNAME=your_leetcode_username

# Your LeetCode session cookie (needed to fetch your following list)
# How to get it:
#   1. Open leetcode.com and log in
#   2. Open DevTools (F12) → Application tab → Cookies → leetcode.com
#   3. Copy the value of "LEETCODE_SESSION"
LEETCODE_SESSION=your_session_cookie_here

# Discord Webhook URL (for notifications when someone solves a problem)
# How to get it:
#   1. Open Discord → go to your server/channel
#   2. Click the ⚙️ gear icon next to the channel name → Integrations → Webhooks
#   3. Click "New Webhook" → give it a name → click "Copy Webhook URL"
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Cron schedule for polling submissions (default: every 5 minutes)
POLL_CRON=*/5 * * * *

# Cron schedule for syncing your following list (default: every 30 minutes)
SYNC_FOLLOWING_CRON=*/30 * * * *
